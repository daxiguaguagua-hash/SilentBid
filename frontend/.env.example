# SilentBid frontend environment variables
# Copy this file to .env and fill in the values.

# Sepolia contract address
VITE_CONTRACT_ADDRESS=0xAB06CB9cddC96B4c8725F3298548e56CbC10994d

# Sepolia RPC URL (optional — defaults to public Alchemy endpoint)
# VITE_SEPOLIA_RPC=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# Enable test-only features: Debug Plain Bid, End Auction, Restart Auction
# Set to "true" only for development/testing. Remove for production.
VITE_ENABLE_TEST_CONTROLS=false
